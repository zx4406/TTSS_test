{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C++: build active file (OpenMP)",
            "command": "C:/MSYS2/ucrt64/bin/g++.exe",
            "args": [
                "-fopenmp",
                "-g",
                "${fileBasename}",
                "-o",
                "${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}